APP_NAME="HRIS Gemilang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hris.gemilangsari.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ====================================================
# Single Tenant Lock (Gemilang Edition)
# ====================================================
SINGLE_TENANT_MODE=true
SINGLE_TENANT_COMPANY_ID=1

# ====================================================
# Brand (client-facing white-label identity)
# ====================================================
BRAND_NAME="HR Gemilang"
BRAND_LOGO_PATH="images/brand/logo.svg"
BRAND_LOGO_MARK_PATH="images/brand/logo-mark.svg"
BRAND_FAVICON_PATH="images/brand/favicon.svg"
BRAND_PRIMARY_COLOR="#1d4ed8"
BRAND_ACCENT_COLOR="#f97316"
BRAND_FOOTER_TEXT="HR Gemilang - Sistem HRIS PT Gemilang Sari Husada"

# ====================================================
# Logging
# ====================================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ====================================================
# Database (MySQL production)
# ====================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gajipro_production
DB_USERNAME=gajipro_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ====================================================
# Session & Cache (Redis recommended)
# ====================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ====================================================
# File storage
# ====================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ====================================================
# Mail (SMTP client)
# ====================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@gemilangsari.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@gemilangsari.com"
MAIL_FROM_NAME="HRIS Gemilang"

# ====================================================
# Backup (S3 / Off-site)
# ====================================================
BACKUP_ARCHIVE_PASSWORD=CHANGE_ME_BACKUP_PASSWORD
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=gemilang-gajipro-backup
AWS_USE_PATH_STYLE_ENDPOINT=false

# ====================================================
# Frontend
# ====================================================
VITE_APP_NAME="${APP_NAME}"

# ====================================================
# Demo Mode (disabled in production)
# ====================================================
SHOW_DEMO_ACCOUNTS=false
